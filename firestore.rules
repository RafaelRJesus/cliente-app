rules_version = '2';

// Os tamanhos máximos espelham src/lib/limites.js (o teste limites.test.js confere).
// Os cálculos do contrato rodam no navegador; aqui só validamos dono, formato e tamanho.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // E-mail confirmado: sem isso qualquer um criaria conta com o e-mail de outra pessoa.
    function emailConfirmado() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function usuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Admin só vale com sessão aberta pelo Google (protegida pelo 2FA da conta
    // Google): uma senha vazada não dá acesso de admin.
    function isAdmin() {
      return temPerfil() && usuario().papel == 'admin'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Perfil existente e não bloqueado pelo admin.
    function ativo() {
      return temPerfil() && usuario().get('bloqueado', false) == false;
    }

    // admin ou gestor: enxergam a carteira inteira. O gestor perde o acesso
    // quando o admin apaga o convite dele ou bloqueia o usuário.
    function isEquipe() {
      return isAdmin()
        || (ativo() && usuario().papel == 'gestor'
          && exists(/databases/$(database)/documents/gestores/$(request.auth.token.email)));
    }

    function meuClienteId() {
      return usuario().clienteId;
    }

    function isClienteDono(clienteId) {
      return ativo() && usuario().papel == 'cliente' && meuClienteId() == clienteId;
    }

    function stringField(name, maxSize) {
      return request.resource.data[name] is string
        && request.resource.data[name].size() <= maxSize;
    }

    // Campo de texto opcional dentro de um map.
    function texto(m, key, maxSize) {
      return !(key in m) || (m[key] is string && m[key].size() <= maxSize);
    }

    function numero(m, key) {
      return !(key in m) || m[key] is number;
    }

    function enderecoValido(e) {
      return e is map
        && e.keys().hasOnly(['cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf'])
        && texto(e, 'cep', 9)
        && texto(e, 'logradouro', 120)
        && texto(e, 'numero', 10)
        && texto(e, 'complemento', 60)
        && texto(e, 'bairro', 60)
        && texto(e, 'cidade', 60)
        && texto(e, 'uf', 2);
    }

    function detalhesValidos(d) {
      return d is map
        && d.keys().hasOnly([
          'convenio', 'renda',
          'placa', 'veiculo', 'anoModelo', 'codigoFipe', 'valorFipe', 'referenciaFipe',
          'tipoImovel', 'valorImovel',
          'valorPix', 'iofFinanciado'])
        && texto(d, 'convenio', 60)
        && texto(d, 'placa', 8)
        && texto(d, 'veiculo', 120)
        && texto(d, 'codigoFipe', 10)
        && texto(d, 'referenciaFipe', 40)
        && texto(d, 'tipoImovel', 30)
        && numero(d, 'renda')
        && numero(d, 'anoModelo')
        && numero(d, 'valorFipe')
        && numero(d, 'valorImovel')
        && numero(d, 'valorPix')
        && (!('iofFinanciado' in d) || d.iofFinanciado is bool);
    }

    // Rules não permitem laço; conferimos o formato da primeira e da última parcela.
    function parcelaValida(p) {
      return p is map
        && p.keys().hasOnly(['numero', 'vencimento', 'amortizacao', 'juros', 'valor', 'saldo',
          'pagaEm', 'valorPago', 'formaPagamento'])
        && (!('formaPagamento' in p)
          || p.formaPagamento in ['pix', 'credito', 'debito', 'boleto', 'dinheiro'])
        && p.numero is int
        && p.vencimento is string && p.vencimento.size() == 10
        && p.valor is number;
    }

    function parcelasValidas(parcelas, prazo) {
      return parcelas is list
        && parcelas.size() == prazo
        && parcelaValida(parcelas[0])
        && parcelaValida(parcelas[parcelas.size() - 1]);
    }

    // Perfil de acesso. Admin é criado à mão no console; ninguém se promove.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if emailConfirmado()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && stringField('nome', 120)
        && stringField('criadoEm', 30)
        && (
          // gestor: o admin precisa ter cadastrado esse e-mail antes
          (request.resource.data.keys().hasOnly(['papel', 'email', 'nome', 'criadoEm'])
            && request.resource.data.papel == 'gestor'
            && exists(/databases/$(database)/documents/gestores/$(request.auth.token.email)))
          ||
          // cliente: o cadastro com esse CPF precisa ter o mesmo e-mail da conta
          (request.resource.data.keys().hasOnly(['papel', 'email', 'nome', 'clienteId', 'criadoEm'])
            && request.resource.data.papel == 'cliente'
            && request.resource.data.clienteId is string
            && get(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)).data.email
              == request.auth.token.email)
        );

      // O admin só liga/desliga o bloqueio, e nunca de outro admin.
      allow update: if isAdmin()
        && resource.data.papel != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bloqueado'])
        && request.resource.data.bloqueado is bool;

      allow delete: if false;
    }

    // Convites de gestor, pelo e-mail. Só o admin mexe.
    match /gestores/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'criadoEm'])
        && stringField('nome', 120)
        && stringField('criadoEm', 30)
        && email.size() <= 160;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Número do cliente: contador único, que só anda de 1 em 1.
    match /contadores/clientes {
      allow read: if signedIn();
      allow create: if emailConfirmado()
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == 1;
      allow update: if emailConfirmado()
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // O número gravado no cliente tem de ser o próximo do contador, e o
    // contador tem de avançar na mesma gravação (transação).
    function numeroDoCliente() {
      return request.resource.data.numero is int
        && request.resource.data.numero <= 9999999
        && getAfter(/databases/$(database)/documents/contadores/clientes).data.ultimo
          == request.resource.data.numero
        && ((!exists(/databases/$(database)/documents/contadores/clientes)
              && request.resource.data.numero == 1)
          || (exists(/databases/$(database)/documents/contadores/clientes)
              && get(/databases/$(database)/documents/contadores/clientes).data.ultimo + 1
                == request.resource.data.numero));
    }

    // O id do documento é o CPF só com números: garante um cadastro por CPF.
    match /clientes/{cpf} {
      allow read: if isEquipe() || isClienteDono(cpf);
      allow delete: if isEquipe();

      allow create: if signedIn()
        && cpf.matches('^[0-9]{11}$')
        && request.resource.data.cpf is string
        && request.resource.data.cpf.replace('[^0-9]', '') == cpf
        && request.resource.data.keys().hasOnly(
          ['nome', 'email', 'telefone', 'cpf', 'endereco', 'criadoEm', 'criadoPor', 'numero'])
        && request.resource.data.criadoPor == request.auth.uid
        && numeroDoCliente()
        && stringField('nome', 120)
        && request.resource.data.nome.size() > 0
        && stringField('email', 160)
        && stringField('telefone', 20)
        && stringField('cpf', 14)
        && stringField('criadoEm', 30)
        && enderecoValido(request.resource.data.endereco)
        && (
          isEquipe()
          // cliente se cadastrando: só com o próprio e-mail, já confirmado
          || (emailConfirmado() && !temPerfil()
            && request.resource.data.email == request.auth.token.email)
        );

      // Só para dar número a cadastro antigo, que ainda não tem.
      allow update: if isEquipe()
        && !('numero' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['numero'])
        && numeroDoCliente();
    }

    match /contratos/{id} {
      allow read: if isEquipe() || isClienteDono(resource.data.clienteId);
      allow delete: if isEquipe();

      allow create: if isEquipe()
        && request.resource.data.keys().hasOnly([
          'clienteId', 'clienteNome', 'produto', 'detalhes', 'valor',
          'taxaMensal', 'prazo', 'sistema', 'dataContratacao', 'iof', 'cetMensal',
          'parcelas', 'criadoEm', 'criadoPor'])
        && request.resource.data.criadoPor == request.auth.uid
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId))
        && request.resource.data.produto in ['pessoal', 'consignado', 'veiculo', 'imovel', 'pix']
        && stringField('clienteId', 11)
        && stringField('clienteNome', 120)
        && stringField('dataContratacao', 10)
        && stringField('criadoEm', 30)
        && detalhesValidos(request.resource.data.detalhes)
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.valor <= 2100000
        && request.resource.data.taxaMensal is number
        && request.resource.data.taxaMensal >= 0
        && request.resource.data.taxaMensal <= 0.2
        && request.resource.data.prazo is int
        && request.resource.data.prazo >= 1
        && request.resource.data.prazo <= 240
        && request.resource.data.sistema in ['PRICE', 'SAC']
        && parcelasValidas(request.resource.data.parcelas, request.resource.data.prazo);

      // Pagamento: só o cronograma muda, pela equipe ou pelo próprio cliente.
      allow update: if (isEquipe() || isClienteDono(resource.data.clienteId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parcelas'])
        && parcelasValidas(request.resource.data.parcelas, resource.data.prazo);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
