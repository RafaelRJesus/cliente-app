{
  "name": "respawn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "test:e2e": "playwright test",
    "test:regras": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-respawn \"vitest run -c vitest.regras.config.js\"",
    "docs:api": "npx -y @redocly/cli@2.78.0 lint public/api-docs/openapi.yaml"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "firebase": "^13.3.0",
    "papaparse": "^5.7.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.17",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.10.1",
    "swagger-ui-dist": "^5.35.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  }
}
