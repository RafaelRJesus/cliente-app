{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run lint",
      "npm --prefix \"$PROJECT_DIR\" test",
      "npm --prefix \"$PROJECT_DIR\" run build"
    ],
    "postdeploy": [
      "bash \"$PROJECT_DIR/scripts/smoke-producao.sh\""
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/massa/**",
        "function": {
          "functionId": "massa",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "test",
        "src",
        "*.config.js",
        "build.mjs",
        ".gitignore"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" test",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
